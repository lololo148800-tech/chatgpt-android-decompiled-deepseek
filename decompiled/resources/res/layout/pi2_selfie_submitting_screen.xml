<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pending_animation_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/startEndMargin"
        android:layout_marginEnd="@dimen/startEndMargin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.withpersona.sdk2.inquiry.shared.p687ui.ThemeableLottieAnimationView
            android:id="@+id/pending_animation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_percent="?attr/personaInquiryLoadingLottieWidthPercent"
            app:lottie_autoPlay="true"
            app:lottie_enableMergePathsForKitKatAndAbove="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/pi2_id_scan_loading"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/textview_selfie_submitting_title"
        android:paddingTop="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:paddingStart="@dimen/startEndMargin"
        android:paddingEnd="@dimen/startEndMargin"
        android:accessibilityTraversalBefore="@+id/textview_selfie_submitting_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="500dp"
        style="?attr/textAppearanceHeadline6"/>
    <TextView
        android:gravity="center"
        android:id="@+id/textview_selfie_submitting_body"
        android:paddingTop="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:paddingStart="@dimen/startEndMargin"
        android:paddingEnd="@dimen/startEndMargin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="500dp"
        style="?attr/textAppearanceSubtitle1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
